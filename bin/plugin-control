#!/bin/bash

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export LC_ALL=C

SCRIPT_PATH="$(realpath -m -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_PATH
BACKEND_ROOT="$(realpath -m -- "$(dirname -- "$SCRIPT_PATH")/../lib/backend")"
readonly BACKEND_ROOT

for backend_module in common config catalog updates snapshot actions lifecycle; do
  # Workers use the same modules from their staged private directory.
  # shellcheck disable=SC1090
  source "$BACKEND_ROOT/$backend_module.sh"
done
unset backend_module

usage() {
  json_error "usage: plugin-control <cached|refresh|check-updates|preview|ensure-config|config-status|status|action|ack|benchmark> ..."
}

main() {
  local command="${1:-}"
  shift || true
  case "$command" in
    start)
      require_cli_tool jq
      require_cli_tool omarchy
      require_cli_tool omarchy-shell
      require_cli_tool ruby
      init_paths
      local public_root
      public_root="$(source_root "$(dirname -- "$SCRIPT_PATH")/..")" ||
        cli_fail "could not find the installed Plugin Control checkout"
      start_command "$public_root" "$@"
      return
      ;;
    stop)
      require_cli_tool omarchy
      stop_command "$@"
      return
      ;;
    help|-h|--help)
      (( $# == 0 )) || {
        public_usage >&2
        return 2
      }
      public_usage
      return
      ;;
    "")
      public_usage >&2
      return 2
      ;;
  esac

  require_tool curl
  require_tool flock
  require_tool git
  require_tool jq
  require_tool omarchy
  require_tool realpath
  require_tool ruby
  require_tool setsid
  require_tool sha256sum
  require_tool timeout
  init_paths

  case "$command" in
    cached)
      (( $# == 1 )) || { usage; return 2; }
      cached_command "$(source_root "$1")"
      ;;
    refresh)
      (( $# >= 1 && $# <= 2 )) || { usage; return 2; }
      local root
      root="$(source_root "$1")"
      shift
      refresh_command "$root" "${1:-}"
      ;;
    check-updates)
      (( $# == 1 )) || { usage; return 2; }
      check_updates_command "$(source_root "$1")"
      ;;
    preview)
      (( $# == 4 )) || { usage; return 2; }
      require_tool magick
      preview_command "$1" "$2" "$3" "$4"
      ;;
    ensure-config)
      (( $# == 1 )) || { usage; return 2; }
      local root
      root="$(source_root "$1")"
      ensure_config "$root"
      config_status "$root"
      ;;
    config-status)
      (( $# == 1 )) || { usage; return 2; }
      config_status "$(source_root "$1")"
      ;;
    status)
      (( $# == 0 )) || { usage; return 2; }
      status_command
      ;;
    action)
      (( $# == 5 )) || { usage; return 2; }
      action_command "$(source_root "$1")" "$2" "$3" "$4" "$5"
      ;;
    ack)
      (( $# == 1 )) || { usage; return 2; }
      ack_command "$1"
      ;;
    benchmark)
      (( $# == 1 )) || { usage; return 2; }
      benchmark_command "$(source_root "$1")"
      ;;
    _worker)
      (( $# == 6 )) || return 2
      worker_command "$@"
      ;;
    *)
      usage
      return 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
